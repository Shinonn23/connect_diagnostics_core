{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"moduleResolution": "Node16",
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["node"]
	},
	"include": [
		"playwright.config.ts",
		"e2e/**/*.ts",
		"lib/**/*.ts",
		"scripts/**/*.ts"
	]
}
