# Read-only Git inspection is safe without an approval prompt.
prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "Inspecting repository status is read-only.",
    match = ["git status", "git status --short"],
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "Inspecting a Git diff is read-only.",
    match = ["git diff", "git diff --cached --stat"],
)

prefix_rule(
    pattern = ["git", "log"],
    decision = "allow",
    justification = "Inspecting Git history is read-only.",
    match = ["git log --oneline -5"],
)

prefix_rule(
    pattern = ["git", "show"],
    decision = "allow",
    justification = "Inspecting a Git object is read-only.",
    match = ["git show HEAD:README.md"],
)

prefix_rule(
    pattern = ["git", "ls-files"],
    decision = "allow",
    justification = "Listing tracked files is read-only.",
    match = ["git ls-files", "git ls-files --stage"],
)

prefix_rule(
    pattern = ["git", "rev-parse"],
    decision = "allow",
    justification = "Resolving repository metadata is read-only.",
    match = ["git rev-parse --show-toplevel"],
)

# These operations change repository or remote state and should be approved per invocation.
prefix_rule(
    pattern = ["git", "add"],
    decision = "prompt",
    justification = "Staging changes changes repository state; review the exact paths first.",
    match = ["git add README.md"],
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "prompt",
    justification = "Creating a commit changes repository history.",
    match = ["git commit -m docs: update policy"],
)

prefix_rule(
    pattern = ["git", "fetch"],
    decision = "prompt",
    justification = "Fetching changes contacts a remote and updates repository metadata.",
    match = ["git fetch origin developments"],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Pushing changes modifies a remote repository.",
    match = ["git push origin docs/example"],
)

prefix_rule(
    pattern = ["git", "pull"],
    decision = "prompt",
    justification = "Pulling changes modifies the working tree and repository history.",
    match = ["git pull --ff-only"],
)
